PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER_HOST/stackwise?retryWrites=true&w=majority&appName=StackwiseCluster

JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_DAYS=7

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary OCR (Google Vision "adv_ocr") — powers receipt auto-fill.
# Requires the "OCR Text Detection and Extraction" add-on to be subscribed on the
# Cloudinary account (Console > Add-ons). Without it, scan uploads are rejected and
# receipt scanning degrades to manual entry automatically.
OCR_ENABLED=true
OCR_SCRATCH_FOLDER=stackwise/ocr-scratch
OCR_TIMEOUT_MS=40000

# Gmail API OAuth 2.0 credentials. Grant the refresh token the gmail.send scope.
GMAIL_CLIENT_ID=791221947772-q7tfe15034742rau9kp8grsqaba5i0s2.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=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
GMAIL_REFRESH_TOKEN=1//0gUjYkariKziiCgYIARAAGBASNwF-L9IrW1IAgNsm2LEvGV3etzT9rsbB-WDtCSMYjudwHixcE_fNVcZtcLRO9SJnf_7KhSqB88U
GMAIL_FROM_NAME=Stackwise

# Optional; defaults to six hours. Minimum supported value is 60000.
NOTIFICATION_CHECK_INTERVAL_MS=21600000
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

SERVER_PUBLIC_URL=https://your-public-backend.example.com

PAYMENT_CUSTOMER_PHONE=01700000000
PAYMENT_CUSTOMER_ADDRESS=Dhaka
PAYMENT_CUSTOMER_CITY=Dhaka
PAYMENT_CUSTOMER_STATE=Dhaka
PAYMENT_CUSTOMER_POSTCODE=1000
PAYMENT_CUSTOMER_COUNTRY=Bangladesh
